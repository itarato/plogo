intvar("size", 10, 1000, 200)
intvar("angle", 0, 360, 30)
intvar("th", 1, 100, 20)
floatvar("dec", 1.1, 5.0, 1.4)
intvar("lim", 1, 500, 4)

fn branch(size, angle, thick, dec, limit) {
    t(thick)
    f(size)

    if (size > limit) {
        l(angle)
        branch(size / dec, angle, thick / dec, dec, limit)
        r(angle * 2)
        branch(size / dec, angle, thick / dec, dec, limit)
        l(angle)
    }

    t(thick)
    b(size)
}

branch(size, angle, th, dec, lim)
